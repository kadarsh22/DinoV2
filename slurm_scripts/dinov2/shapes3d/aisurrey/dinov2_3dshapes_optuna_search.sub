#!/bin/bash
#SBATCH --job-name=dino_shapes3d_optuna
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --partition=2080ti
#SBATCH --time=24:00:00
#SBATCH --array=0-64%16
#SBATCH --exclude=aisurrey16
#SBATCH -o slurm_outputs/shapes3d/optuna/%x_%A_%a.out
#SBATCH -e slurm_outputs/shapes3d/optuna/%x_%A_%a.err

set -euo pipefail
mkdir -p slurm_outputs/shapes3d/optuna

cd /mnt/fast/nobackup/users/ak03476/PycharmProjects/DinoV2

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


STUDY_NAME="shapes3d_hpo"
STORAGE="optuna_storage/optuna_journal_shapes3d.log"

# Make run names unique per array task (W&B friendliness)
RUN_NAME="shapes3d_optuna_${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}"

srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun \
  --standalone \
  --nproc_per_node=1 \
  main.py \
  --run_name "${RUN_NAME}" \
  --dataset 3dshapes \
  --config_file configs/train/3dshapes/vits16.yaml \
  --eval_fname configs/eval/shapes3d/eval_dinov2.yaml \
  --output_dir /mnt/fast/nobackup/scratch4weeks/ak03476/dinov2_outputs/shapes3d \
  --dataset_path /mnt/fast/nobackup/users/ak03476/data/3dshapes/shapes3d.npz \
  --prune_after 30000
