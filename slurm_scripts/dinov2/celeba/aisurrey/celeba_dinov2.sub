#!/bin/bash
#SBATCH --job-name=dino_celeba_dist
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --partition=3090,3090_risk
#SBATCH --time=72:00:00
#SBATCH --array=0-4
#SBATCH -o slurm_outputs/celeba/baseline/%x_%A_%a.out
#SBATCH -e slurm_outputs/celeba/baseline/%x_%A_%a.err

set -euo pipefail
mkdir -p slurm_outputs/celeba

# -----------------------------
# Seeds (edit as you like)
# -----------------------------
SEED_LIST=(0 456 999 4590 99)
NSEEDS=${#SEED_LIST[@]}

if [[ "${SLURM_ARRAY_TASK_ID}" -ge "${NSEEDS}" ]]; then
  echo "SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID} >= NSEEDS=${NSEEDS}. Exiting."
  exit 1
fi

SEED="${SEED_LIST[$SLURM_ARRAY_TASK_ID]}"

cd /mnt/fast/nobackup/users/ak03476/PycharmProjects/DinoV2

RUN_NAME="celeba_dinov2_baseline_seed${SEED}"

echo "=== Seed trial ${SLURM_ARRAY_TASK_ID}/${NSEEDS} ==="
echo "seed=${SEED}"
echo "run_name=${RUN_NAME}"

# -----------------------------
# Launch (single-node torchrun)
# -----------------------------
srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun --standalone --nproc_per_node=1 main.py \
  --run_name "${RUN_NAME}" \
  --config_file configs/train/celeba/vits16.yaml \
  --dataset CelebA \
  --eval_fname configs/eval/celeba/eval_dinov2.yaml \
  --output_dir /mnt/fast/nobackup/scratch4weeks/ak03476/dinov2_outputs/celeba \
  --dataset_path /mnt/fast/nobackup/users/ak03476/data/celebA \
  train.seed="${SEED}" \
  lcal.loss_weight=0.0
