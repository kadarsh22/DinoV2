#!/bin/bash
#SBATCH --job-name=dino_cmnist_train
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --partition=boost_usr_prod
#SBATCH --time=00-06:00:00
#SBATCH -o slurm_outputs/cmnist/%x_%j.out
#SBATCH -e slurm_outputs/cmnist/%x_%j.err

set -euo pipefail
mkdir -p slurm_outputs

# --- rendezvous info ---
MASTER_ADDR="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)"
MASTER_PORT=$((29500 + (SLURM_JOB_ID % 1000)))   # reduce port collisions

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export NCCL_DEBUG=WARN
export LOGLEVEL=INFO

# W&B
export WANDB_MODE=offline
export WANDB_DIR="${SLURM_SUBMIT_DIR}/wandb"

# --- conda ---
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate dinov2lightly

# --- run ---
srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun --standalone --nproc_per_node=1 main.py \
    --config_file configs/train/cmnist/vits16.yaml \
    --eval_fname configs/eval/cmnist/eval_dinov2.yaml \
    --run_name "dinov2_cmnist_baseline" \
    --dataset cmnist \
    lcal.tau_start=2.0 \
    lcal.tau_end=1.0 \
    lcal.warmup_iterations=1000 \
    lcal.loss_weight=0.0
