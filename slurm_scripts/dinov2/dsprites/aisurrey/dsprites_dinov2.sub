#!/bin/bash
#SBATCH --job-name=dino_dsprites_baseline
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --partition=3090,3090_risk
