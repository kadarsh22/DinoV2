#!/bin/bash
#SBATCH --job-name=dino_baseline_4
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --partition=2080ti
#SBATCH --exclude=aisurrey16
#SBATCH --time=72:00:00
#SBATCH --array=0-4
#SBATCH -o slurm_outputs/celeba/baseline/%x_%A_%a.out
#SBATCH -e slurm_outputs/celeba/baseline/%x_%A_%a.err

set -euo pipefail
mkdir -p slurm_outputs/celeba/seeds

# -----------------------------
# 5 random seeds
# -----------------------------
SEED_LIST=(0 123 32 999 456)
N=${#SEED_LIST[@]}

tid=${SLURM_ARRAY_TASK_ID}
if [[ "$tid" -ge "$N" ]]; then
  echo "SLURM_ARRAY_TASK_ID=${tid} >= N=${N}. Exiting."
  exit 1
fi

SEED="${SEED_LIST[$tid]}"

cd /mnt/fast/nobackup/users/ak03476/PycharmProjects/DinoV2

RUN_NAME="celeba_dinov2_baseline_seed${SEED}"

echo "=== Seed run ${tid}/${N} ==="
echo "seed=${SEED}"
echo "run_name=${RUN_NAME}"

srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun \
  --standalone --nproc_per_node=1 main.py \
  --run_name "${RUN_NAME}" \
  --config_file configs/train/celeba/vits16.yaml \
  --dataset CelebA \
  --eval_fname configs/eval/celeba/eval_dinov2.yaml \
  --output_dir /mnt/fast/nobackup/scratch4weeks/ak03476/dinov2_outputs/celeba \
  --dataset_path /mnt/fast/nobackup/users/ak03476/data/celebA \
  --seed "${SEED}" \
  lcal.tau_start=8.5 \
  lcal.tau_end=3.5 \
  lcal.warmup_iterations=100 \
  lcal.loss_weight=0.0
