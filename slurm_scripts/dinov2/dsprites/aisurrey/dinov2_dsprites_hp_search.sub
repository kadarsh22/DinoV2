#!/bin/bash
#SBATCH --job-name=dino_dsprites_hp
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --partition=3090,3090_risk,2080ti
#SBATCH --time=24:00:00
#SBATCH --array=0-63
#SBATCH -o slurm_outputs/dsprites/hp_search/%x_%A_%a.out
#SBATCH -e slurm_outputs/dsprites/hp_search/%x_%A_%a.err

set -euo pipefail

# Make sure this directory exists *before* submission
mkdir -p slurm_outputs

# -----------------------------
# Hyperparameter grid
# -----------------------------
TAU_START_LIST=(1.8 2.4 2.6 3.0)
TAU_END_LIST=(0.3 0.2 0.1 0.01)
WARMUP_ITERS_LIST=(100 200 400 500)

NS=${#TAU_START_LIST[@]}
NE=${#TAU_END_LIST[@]}
NW=${#WARMUP_ITERS_LIST[@]}
TOTAL=$((NS * NE * NW))

# Guard (still useful if someone edits --array later)
if [[ "${SLURM_ARRAY_TASK_ID}" -ge "${TOTAL}" ]]; then
  echo "SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID} >= TOTAL=${TOTAL}. Exiting."
  exit 1
fi

# Map array index -> (i, j, k)
tid=${SLURM_ARRAY_TASK_ID}
i=$(( tid % NS ))
j=$(( (tid / NS) % NE ))
k=$(( tid / (NS * NE) ))

TAU_START=${TAU_START_LIST[$i]}
TAU_END=${TAU_END_LIST[$j]}
WARMUP_ITERS=${WARMUP_ITERS_LIST[$k]}

RUN_NAME="dinov2_dsprites_ours_hp_tauS${TAU_START}_tauE${TAU_END}_wu${WARMUP_ITERS}"

echo "=== Trial ${tid}/${TOTAL} ==="
echo "tau_start=${TAU_START}"
echo "tau_end=${TAU_END}"
echo "warmup_iters=${WARMUP_ITERS}"
echo "run_name=${RUN_NAME}"

cd /mnt/fast/nobackup/users/ak03476/PycharmProjects/DinoV2

# -----------------------------
# Launch (single-node torchrun)
# -----------------------------
srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun \
  --standalone \
  --nproc_per_node=1 \
  main.py \
  --run_name "${RUN_NAME}" \
  --dataset dsprites \
  --config_file configs/train/dsprites/vits16.yaml \
  --eval_fname configs/eval/dsprites/eval_dinov2.yaml \
  --output_dir /mnt/fast/nobackup/scratch4weeks/ak03476/dinov2_outputs/dsprites \
  --dataset_path /mnt/fast/nobackup/users/ak03476/data/dsprites/dsprites_ndarray_co1sh3sc6or40x32y32_64x64.npz \
  lcal.tau_start="${TAU_START}" \
  lcal.tau_end="${TAU_END}" \
  lcal.warmup_iterations="${WARMUP_ITERS}" \
  lcal.loss_weight=1.0
