# Launch (single-node torchrun)
# -----------------------------
srun /mnt/fast/nobackup/users/ak03476/miniconda3/envs/dinov2/bin/torchrun --standalone --nproc_per_node=1 main.py \
  --run_name "dsprites_dinov2_baseline" \
  --config_file \
  configs/train/dsprites/vits16.yaml\
  --dataset \
  dsprites \
  --eval_fname \
  configs/eval/dsprites/eval_dinov2.yaml \
  --output_dir \
  /mnt/fast/nobackup/scratch4weeks/ak03476/dinov2_outputs/dsprites \
  --dataset_path \
  /mnt/fast/nobackup/users/ak03476/data/dsprites/dsprites_ndarray_co1sh3sc6or40x32y32_64x64.npz \
  lcal.loss_weight=0.0
