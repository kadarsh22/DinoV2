#!/bin/bash
#SBATCH --job-name=dinov2_22k_hp
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --partition=boost_usr_prod
#SBATCH --time=00-02:00:00
#SBATCH -o slurm_outputs/dinov2_hp/%x_%A_%a.out
#SBATCH -e slurm_outputs/dinov2_hp/%x_%A_%a.err
#SBATCH --array=0-23

set -euo pipefail
mkdir -p slurm_outputs/dinov2_hp

# -----------------------
# Environment
# -----------------------
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate dinov2lightly

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export NCCL_DEBUG=WARN
export WANDB_MODE=offline
export WANDB_DIR="${SLURM_SUBMIT_DIR}/wandb"

# -----------------------
# Dataset / configs
# -----------------------
DATASET="cmnist"
DATASET_PATH="/leonardo_work/EUHPC_D27_070/data/cmnist_lff/ijepa_data/uncorrelated/ColoredMNIST-Skewed0.9-Severity1"   # set to absolute path if your code needs it
TRAIN_CFG="configs/train/cmnist/vits16.yaml"  # <-- set to your yaml that contains the snippet you posted
SEED=123

# -----------------------
# 24-run sweep (most relevant knobs)
# Sweep: base_lr, weight_decay, momentum_teacher, teacher_temp
# Total runs = 3 * 2 * 2 * 2 = 24  => array 0..23
# -----------------------
LRS=(1e-5 2e-5 4e-5)
WDS=(0.02 0.04)
MOMS=(0.994 0.996)
TTS=(0.05 0.06)

# Fixed from your config
WARMUP_TT="0.04"
FINAL_MOM="1.0"

# -----------------------
# Index mapping
# -----------------------
N_LR=${#LRS[@]}
N_WD=${#WDS[@]}
N_MOM=${#MOMS[@]}
N_TT=${#TTS[@]}
TOTAL=$((N_LR * N_WD * N_MOM * N_TT))

if [[ "${SLURM_ARRAY_TASK_ID}" -ge "${TOTAL}" ]]; then
  echo "SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID} out of range (TOTAL=${TOTAL})"
  exit 1
fi

tid=${SLURM_ARRAY_TASK_ID}

i_tt=$(( tid % N_TT ))
tid=$(( tid / N_TT ))

i_mom=$(( tid % N_MOM ))
tid=$(( tid / N_MOM ))

i_wd=$(( tid % N_WD ))
tid=$(( tid / N_WD ))

i_lr=$(( tid % N_LR ))

LR="${LRS[$i_lr]}"
WD="${WDS[$i_wd]}"
MOM="${MOMS[$i_mom]}"
TT="${TTS[$i_tt]}"

RUN_NAME="in22k_vits7_lr${LR}_wd${WD}_mom${MOM}_tt${TT}_job${SLURM_JOB_ID}_a${SLURM_ARRAY_TASK_ID}"

echo "RUN_NAME=${RUN_NAME}"
echo "LR=${LR} WD=${WD} MOM=${MOM} TT=${TT} WARMUP_TT=${WARMUP_TT} FINAL_MOM=${FINAL_MOM}"

# -----------------------
# Launch
# -----------------------
torchrun --standalone --nproc_per_node=1 main.py \
  --run_name "${RUN_NAME}" \
  --config-file "${TRAIN_CFG}" \
  --dataset "${DATASET}" \
  --dataset_path "${DATASET_PATH}" \
  --seed "${SEED}" \
  optim.base_lr="${LR}" \
  optim.weight_decay="${WD}" \
  teacher.momentum_teacher="${MOM}" \
  teacher.final_momentum_teacher="${FINAL_MOM}" \
  teacher.warmup_teacher_temp="${WARMUP_TT}" \
  teacher.teacher_temp="${TT}"
